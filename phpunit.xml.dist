<?xml version="1.0" encoding="UTF-8"?>
<!--
	PHPUnit's view of the suite. The cases themselves are in tests/cases.php and
	are shared with `php tests/run.php`, which needs none of this; see
	tests/harness.php and the testing section of README.md.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/phpunit/bootstrap.php"
         cacheDirectory="build/phpunit"
         colors="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnSkippedTests="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="false">
	<testsuites>
		<testsuite name="mcm">
			<directory>tests/phpunit</directory>
		</testsuite>
	</testsuites>

	<!--
		The machine-readable report, written on every run. A checker reads this
		rather than parsing the screen; build/ is generated and git-ignored.
	-->
	<logging>
		<junit outputFile="build/logs/junit.xml"/>
	</logging>

	<source>
		<include>
			<directory suffix=".php">inc</directory>
		</include>
	</source>
</phpunit>
