# Private runtime configuration. Real values are never part of this
# repository; only inc/config/example_config.php (placeholders) is committed.
inc/config/config.php

# Database schema dump used during first-time setup. The copy in this
# repository stays tracked on purpose (see README.md); any additional local
# copy an operator edits with real database details must never be committed.
.your_database.sql

# Generated / third-party artifacts. /vendor is what Composer installs for the
# development tooling and is never served; /build is where PHPUnit writes its
# cache and its machine-readable report.
/vendor/
/var/
/build/

# Logs
*.log

# Environment files
.env*
